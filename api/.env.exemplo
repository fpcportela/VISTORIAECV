DATABASE_URL=postgres://app_api:app_dev@localhost:5432/vistoria_ecv
JWT_SECRET=troque-este-segredo
PORT=3001

# API Placas (apiplacas.com.br). Pegue o token no painel da conta.
API_PLACAS_TOKEN=
# Rota usada: basico (R$ 0,03), basico-fipe (R$ 0,08) ou completa (R$ 0,20, com chassi, motor e renavam)
API_PLACAS_ROTA=completa
# Dias que uma consulta fica guardada antes de cobrar de novo
API_PLACAS_CACHE_DIAS=30
# Consulta de CNPJ (dados públicos da Receita). Normalmente não precisa mudar.
# BRASILAPI_URL=https://brasilapi.com.br/api
# Marcas e modelos (tabela FIPE). Só mude se usar outro endereço:
# FIPE_URL=https://parallelum.com.br/fipe/api/v1
# Backup: comando que gera o arquivo. O padrão usa o contêiner do docker compose:
# BACKUP_CMD=docker exec vistoria-ecv-banco pg_dump -U vistoria -Fc vistoria_ecv
