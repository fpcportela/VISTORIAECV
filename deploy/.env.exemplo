# Copie para deploy/.env no servidor (chmod 600). Nunca vai para o GitHub.
# Gere cada senha com:  openssl rand -hex 32   (só letras e números, para não quebrar as URLs)

DOMINIO=vistoriaecv.novatec.cloud

DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

# WhatsApp por QR code (Evolution). WHATSAPP=sim liga o serviço no deploy.
WHATSAPP=sim
WHATSAPP_PROVEDOR=evolution
EVOLUTION_API_KEY=

# API Placas (copie do api/.env do Mac)
API_PLACAS_TOKEN=
API_PLACAS_ROTA=completa
API_PLACAS_CACHE_DIAS=30

# Robô com IA (opcional; copie do api/.env do Mac)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-haiku-5-5

# WhatsApp oficial da Meta (só se trocar WHATSAPP_PROVEDOR=meta)
# WHATSAPP_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_MODELO_CODIGO=codigo_acesso

# Cópia diária do backup para fora do servidor (rclone já configurado com: rclone config)
# Exemplo para o Google Drive: RCLONE_DESTINO=gdrive:Vistoria ECV - backups/servidor
RCLONE_DESTINO=
# Quantos dias de backup ficam no servidor
BACKUP_DIAS=14
